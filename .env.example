# ──────────────── Cofferant configuration ────────────────
# `make env` copies this to .env and generates every secret for you.

# How this server is used:
#   standalone  one cafe on its own domain (customer self-hosting, or your own single cafe)
#   platform    YOUR domain: every customer gets <slug>.PLATFORM_DOMAIN + the /developer/ license panel
DEPLOYMENT_MODE=standalone

# The domain (standalone: the cafe's domain, platform: your root domain, e.g. cofferant.ir)
APP_DOMAIN=
PLATFORM_DOMAIN=localhost
LETSENCRYPT_EMAIL=

# Where the app container listens. Keep it on loopback when host nginx terminates TLS.
WEB_BIND=127.0.0.1
WEB_PORT=8081
VERSION=latest

DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# First owner/developer account (created on start-up; password >= 12 chars)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Licensing for SELF-HOSTED customers (given to you by the developer panel) ----
LICENSE_ENFORCE=0
LICENSE_KEY=
LICENSE_SERVER_URL=
LICENSE_GRACE_HOURS=72

# ---- Platform mode: marketing page ----
SALES_CONTACT=
PRICE_1M=490000
PRICE_3M=1290000
PRICE_6M=2390000
PRICE_1Y=4290000
PRICE_2Y=7490000
PRICE_FOREVER=14900000

# ---- Tuning ----
ORDER_RATE_LIMIT=6
WEB_WORKERS=2
WEB_THREADS=4

# Wildcard certificates for platform mode via Cloudflare DNS (optional, enables auto-renewal)
CF_API_TOKEN=
